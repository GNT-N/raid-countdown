# Copiez ce fichier, renommez la copie en « .env », puis remplissez
# les deux valeurs ci-dessous.
#
# Ne partagez jamais votre fichier .env : le token donne le contrôle
# total du bot à qui le possède.


# Token de VOTRE bot Discord.
# https://discord.com/developers/applications
#   > votre application > Bot > Reset Token
DISCORD_TOKEN=

# Identifiant de VOTRE serveur Discord.
# Discord > Paramètres > Avancé > Mode développeur,
# puis clic droit sur le serveur > Copier l'identifiant du serveur.
GUILD_ID=
